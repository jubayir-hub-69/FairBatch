// Access-controlled MockERC20 with configurable decimals, owner/minter roles,
// and owner-only USDC-style blacklist hook for Sepolia & settlement-liveness testing.

use std::evm::StorageMap

pub msg MockErc20Msg {
    #[selector = sol("decimals()")]
    Decimals -> u8,

    #[selector = sol("totalSupply()")]
    TotalSupply -> u256,

    #[selector = sol("balanceOf(address)")]
    BalanceOf { account: Address } -> u256,

    #[selector = sol("allowance(address,address)")]
    Allowance { owner: Address, spender: Address } -> u256,

    #[selector = sol("owner()")]
    Owner -> Address,

    #[selector = sol("minter()")]
    Minter -> Address,

    #[selector = sol("transfer(address,uint256)")]
    Transfer { to: Address, amount: u256 } -> bool,

    #[selector = sol("approve(address,uint256)")]
    Approve { spender: Address, amount: u256 } -> bool,

    #[selector = sol("transferFrom(address,address,uint256)")]
    TransferFrom { from: Address, to: Address, amount: u256 } -> bool,

    #[selector = sol("mint(address,uint256)")]
    Mint { to: Address, amount: u256 } -> bool,

    #[selector = sol("mintAndApprove(address,address,uint256)")]
    MintAndApprove { owner: Address, spender: Address, amount: u256 } -> bool,

    #[selector = sol("setMinter(address)")]
    SetMinter { account: Address } -> bool,

    #[selector = sol("setBlacklisted(address,bool)")]
    SetBlacklisted { account: Address, blocked: bool } -> bool,
}

pub contract MockERC20 uses (ctx: Ctx) {
    token_decimals: u8,
    token_owner: Address,
    mut token_minter: Address,
    mut supply: u256,
    mut balances: StorageMap<Address, u256>,
    mut allowances: StorageMap<(Address, Address), u256>,
    mut blacklisted: StorageMap<Address, bool>,

    init(decimals: u8)
    uses (ctx, mut token_decimals, mut token_owner, mut token_minter)
    {
        token_decimals = decimals
        token_owner = ctx.caller()
        token_minter = Address::zero()
    }

    recv MockErc20Msg {
        Decimals -> u8 uses (token_decimals) {
            token_decimals
        }

        TotalSupply -> u256 uses (supply) {
            supply
        }

        BalanceOf { account } -> u256 uses (balances) {
            balances.get(key: account)
        }

        Allowance { owner, spender } -> u256 uses (allowances) {
            allowances.get(key: (owner, spender))
        }

        Owner -> Address uses (token_owner) {
            token_owner
        }

        Minter -> Address uses (token_minter) {
            token_minter
        }

        Transfer { to, amount } -> bool uses (ctx, mut balances, blacklisted) {
            let sender = ctx.caller()
            assert!(!blacklisted.get(key: sender), "Sender blacklisted")
            assert!(!blacklisted.get(key: to), "Recipient blacklisted")
            let bal = balances.get(key: sender)
            assert!(bal >= amount, "Insufficient balance")
            balances.set(key: sender, value: bal - amount)
            balances.set(key: to, value: balances.get(key: to) + amount)
            true
        }

        Approve { spender, amount } -> bool uses (ctx, mut allowances) {
            let owner = ctx.caller()
            allowances.set(key: (owner, spender), value: amount)
            true
        }

        TransferFrom { from, to, amount } -> bool
        uses (ctx, mut balances, mut allowances, blacklisted)
        {
            let spender = ctx.caller()
            assert!(!blacklisted.get(key: from), "Owner blacklisted")
            assert!(!blacklisted.get(key: to), "Recipient blacklisted")
            let allowed = allowances.get(key: (from, spender))
            assert!(allowed >= amount, "Insufficient allowance")
            let bal = balances.get(key: from)
            assert!(bal >= amount, "Insufficient balance")
            allowances.set(key: (from, spender), value: allowed - amount)
            balances.set(key: from, value: bal - amount)
            balances.set(key: to, value: balances.get(key: to) + amount)
            true
        }

        Mint { to, amount } -> bool uses (
            ctx,
            token_owner,
            token_minter,
            mut supply,
            mut balances,
        ) {
            let caller = ctx.caller()
            assert!(
                caller == token_owner
                    || (token_minter != Address::zero() && caller == token_minter),
                "Not authorized to mint",
            )
            supply = supply + amount
            balances.set(key: to, value: balances.get(key: to) + amount)
            true
        }

        MintAndApprove { owner, spender, amount } -> bool
        uses (ctx, token_owner, mut supply, mut balances, mut allowances)
        {
            assert!(ctx.caller() == token_owner, "Not token owner")
            supply = supply + amount
            balances.set(key: owner, value: balances.get(key: owner) + amount)
            allowances
                .set(
                    key: (owner, spender),
                    value: allowances.get(key: (owner, spender)) + amount,
                )
            true
        }

        SetMinter { account } -> bool uses (ctx, token_owner, mut token_minter) {
            assert!(ctx.caller() == token_owner, "Not token owner")
            token_minter = account
            true
        }

        SetBlacklisted { account, blocked } -> bool
        uses (ctx, token_owner, mut blacklisted)
        {
            assert!(ctx.caller() == token_owner, "Not token owner")
            blacklisted.set(key: account, value: blocked)
            true
        }
    }
}
