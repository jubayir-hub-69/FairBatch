// Group B: Property, Invariant & MEV Game-Theory Proof Tests
// ============================================================================

#[test]
fn property_order_permutation_invariance() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    // 6 heterogeneous orders including ITM, OTM, and 2 marginal sellers at the exact pinned price 2,850!
    let o0 = make_order(
        id: 10,
        trader_id: 0xA0,
        side: SELL_BASE,
        amount_in: 1 * WAD,
        limit_price: 2_200 * WAD,
    )
    let o1 = make_order(
        id: 11,
        trader_id: 0xA1,
        side: SELL_BASE,
        amount_in: 4 * WAD,
        limit_price: 2_850 * WAD,
    )
    let o2 = make_order(
        id: 12,
        trader_id: 0xA2,
        side: SELL_BASE,
        amount_in: 6 * WAD,
        limit_price: 2_850 * WAD,
    )
    let o3 = make_order(
        id: 13,
        trader_id: 0xA3,
        side: SELL_BASE,
        amount_in: 3 * WAD,
        limit_price: 3_400 * WAD,
    )
    let o4 = make_order(
        id: 14,
        trader_id: 0xA4,
        side: BUY_BASE,
        amount_in: 5_000 * WAD,
        limit_price: 3_300 * WAD,
    )
    let o5 = make_order(
        id: 15,
        trader_id: 0xA5,
        side: BUY_BASE,
        amount_in: 4_000 * WAD,
        limit_price: 2_500 * WAD,
    )

    // Permutation 1: [o0, o1, o2, o3, o4, o5]
    var p1: MemVec<Order> = MemVec::new()
    p1.push(o0)
    p1.push(o1)
    p1.push(o2)
    p1.push(o3)
    p1.push(o4)
    p1.push(o5)

    // Permutation 2 (reversed): [o5, o4, o3, o2, o1, o0]
    var p2: MemVec<Order> = MemVec::new()
    p2.push(o5)
    p2.push(o4)
    p2.push(o3)
    p2.push(o2)
    p2.push(o1)
    p2.push(o0)

    // Permutation 3 (interleaved): [o2, o4, o0, o5, o3, o1]
    var p3: MemVec<Order> = MemVec::new()
    p3.push(o2)
    p3.push(o4)
    p3.push(o0)
    p3.push(o5)
    p3.push(o3)
    p3.push(o1)

    let r1 = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: p1.as_slice(),
    )
    let r2 = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: p2.as_slice(),
    )
    let r3 = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: p3.as_slice(),
    )

    assert!(
        r1.clearing_price == r2.clearing_price && r2.clearing_price == r3.clearing_price,
    )
    assert!(
        r1.cow_matched_base_norm == r2.cow_matched_base_norm
            && r2.cow_matched_base_norm == r3.cow_matched_base_norm,
    )
    assert!(
        r1.reserve_base_after_raw == r2.reserve_base_after_raw
            && r2.reserve_base_after_raw == r3.reserve_base_after_raw,
    )
    assert!(
        r1.reserve_quote_after_raw == r2.reserve_quote_after_raw
            && r2.reserve_quote_after_raw == r3.reserve_quote_after_raw,
    )

    // Verify o1 (index 1 in p1, index 4 in p2, index 5 in p3) has bit-for-bit identical fills!
    assert!(r1.fills[1].amount_filled == r2.fills[4].amount_filled)
    assert!(r1.fills[1].amount_filled == r3.fills[5].amount_filled)
    assert!(r1.fills[1].payout_out == r2.fills[4].payout_out)
    assert!(r1.fills[1].payout_out == r3.fills[5].payout_out)
}

#[test]
fn property_lnd_invariant_across_imbalanced_regimes() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    // Regime 1: Whale sell (50 ETH)
    var sell_whale: MemVec<Order> = MemVec::new()
    sell_whale
        .push(
            make_order(
                id: 0,
                trader_id: 0xB1,
                side: SELL_BASE,
                amount_in: 50 * WAD,
                limit_price: 1_000 * WAD,
            ),
        )
    let out1 = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: sell_whale.as_slice(),
    )
    assert!(
        verify_lnd_invariant(
            rx_before: rx,
            ry_before: ry,
            rx_after: out1.reserve_base_after_raw,
            ry_after: out1.reserve_quote_after_raw,
        ),
    )
    assert!(
        out1.reserve_base_after_raw * out1.reserve_quote_after_raw > rx * ry,
    )

    // Regime 2: Whale buy (180,000 USDC)
    var buy_whale: MemVec<Order> = MemVec::new()
    buy_whale
        .push(
            make_order(
                id: 0,
                trader_id: 0xB2,
                side: BUY_BASE,
                amount_in: 180_000 * WAD,
                limit_price: 10_000 * WAD,
            ),
        )
    let out2 = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: buy_whale.as_slice(),
    )
    assert!(
        verify_lnd_invariant(
            rx_before: rx,
            ry_before: ry,
            rx_after: out2.reserve_base_after_raw,
            ry_after: out2.reserve_quote_after_raw,
        ),
    )
    assert!(
        out2.reserve_base_after_raw * out2.reserve_quote_after_raw > rx * ry,
    )
}

#[test]
fn proof_mev_sandwich_zero_profit() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    // Victim wants to buy ETH with 30,000 USDC (max 3,800 USDC/ETH).
    // MEV Bot attempts classic sandwich:
    //   1. Front-run BuyBase with 30,000 USDC
    //   2. Back-run SellBase with 10 ETH
    var orders: MemVec<Order> = MemVec::new()
    let bot_quote_in = 30_000 * WAD
    let bot_base_in = 10 * WAD

    // Front-run (arrives first!)
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xDEAD,
                side: BUY_BASE,
                amount_in: bot_quote_in,
                limit_price: 5_000 * WAD,
            ),
        )
    // Victim (arrives in the middle)
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0xBEEF,
                side: BUY_BASE,
                amount_in: 30_000 * WAD,
                limit_price: 3_800 * WAD,
            ),
        )
    // Back-run (arrives last!)
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0xDEAD,
                side: SELL_BASE,
                amount_in: bot_base_in,
                limit_price: 1_000 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )
    let p_star = out.clearing_price

    // Mark-to-market value of MEV Bot's portfolio BEFORE vs AFTER at uniform clearing price `p*`:
    let bot_value_before = bot_quote_in + mul_div(bot_base_in, p_star.raw(), WAD)

    let front_fill = out.fills[0] // Bot bought Base (`payout_out`), Quote refund (`refund_in`)
    let back_fill = out.fills[2] // Bot sold Base (`refund_in` Base left, `payout_out` Quote received)
    let bot_base_after = front_fill.payout_out + back_fill.refund_in
    let bot_quote_after = front_fill.refund_in + back_fill.payout_out
    let bot_value_after = bot_quote_after + mul_div(bot_base_after, p_star.raw(), WAD)

    // Bot earns <= 0 profit (strictly zero in continuous math, <= 0 with floor rounding)!
    assert!(bot_value_after <= bot_value_before)
}

