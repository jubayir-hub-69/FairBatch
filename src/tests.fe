#[test]
fn effect_lp_lock_expiry_before_and_after_unlock() {
    let empty_lock = LiquidityLock { locked_shares: 0, unlock_time: Timestamp::from_seconds(0) }

    // Lock 400 shares for 1 hour starting at t = 1,000 -> unlock_time = 4,600
    let lock1 = with (BatchClock = MockClock { ts: Timestamp::from_seconds(1_000) }) {
        compute_updated_lock(
            cur: empty_lock,
            minted: 400,
            lock_duration: seconds(3_600),
        )
    }
    assert!(lock1.locked_shares == 400)
    assert!(lock1.unlock_time == Timestamp::from_seconds(4_600))

    // Owned = 1,000 total (600 unlocked + 400 locked). Before unlock (t = 4,599):
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(4_599) }) {
        let info = evaluate_liquidity_lock(owned: 1_000, lock: lock1)
        assert!(info.locked_shares == 400)
        assert!(info.unlocked_shares == 600)
        assert!(info.unlock_time == Timestamp::from_seconds(4_600))
        // Partial withdrawal of unlocked shares succeeds and does not clear active lock
        let clear = assert_removable_shares(owned: 1_000, shares: 600, lock: lock1)
        assert!(!clear)
    }

    // At exact unlock boundary (t = 4,600): all 1,000 shares become unlocked and lock clears
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(4_600) }) {
        let info_after = evaluate_liquidity_lock(owned: 1_000, lock: lock1)
        assert!(info_after.locked_shares == 0)
        assert!(info_after.unlocked_shares == 1_000)
        let clear_after = assert_removable_shares(owned: 1_000, shares: 1_000, lock: lock1)
        assert!(clear_after)
    }
}

#[test(should_revert)]
fn effect_revert_lp_lock_rejects_locked_shares_before_unlock() {
    let lock = LiquidityLock { locked_shares: 400, unlock_time: Timestamp::from_seconds(4_600) }
    // Owned = 1,000 -> only 600 unlocked; withdrawing 601 before t = 4,600 reverts!
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(4_599) }) {
        let _ = assert_removable_shares(owned: 1_000, shares: 601, lock)
    }
}

#[test]
fn effect_faucet_cooldown_before_and_after_with_mock_clock() {
    let cooldown = seconds(43_200) // 12 hours

    // Never claimed before: immediately eligible at t = 10,000
    let (claimed_at, next_at) = with (
        BatchClock = MockClock { ts: Timestamp::from_seconds(10_000) },
    ) {
        let st = evaluate_faucet_status(prev: Timestamp::from_seconds(0), cooldown)
        assert!(st.can_claim)
        assert_faucet_claimable(prev: Timestamp::from_seconds(0), cooldown)
    }
    assert!(claimed_at == Timestamp::from_seconds(10_000))
    assert!(next_at == Timestamp::from_seconds(53_200))

    // 1 second before cooldown expires (t = 53,199): blocked
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(53_199) }) {
        let st = evaluate_faucet_status(prev: claimed_at, cooldown)
        assert!(!st.can_claim)
        assert!(st.next_claim_at == Timestamp::from_seconds(53_200))
    }

    // At exact cooldown expiry (t = 53,200): eligible again!
    let (second_at, second_next) = with (
        BatchClock = MockClock { ts: Timestamp::from_seconds(53_200) },
    ) {
        let st = evaluate_faucet_status(prev: claimed_at, cooldown)
        assert!(st.can_claim)
        assert_faucet_claimable(prev: claimed_at, cooldown)
    }
    assert!(second_at == Timestamp::from_seconds(53_200))
    assert!(second_next == Timestamp::from_seconds(96_400))
}

#[test(should_revert)]
fn effect_revert_faucet_cooldown_active_with_mock_clock() {
    let cooldown = seconds(43_200)
    let prev = Timestamp::from_seconds(10_000)
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(53_199) }) {
        let _ = assert_faucet_claimable(prev, cooldown)
    }
}

