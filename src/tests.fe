#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_slash_before_reveal_expiry() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 201)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 202)
    let bond = gwei(100_000)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, seconds(60), seconds(60), bond),
            salt: 203,
        )

    let cid: u256 = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: bond,
            message: FairBatchMsg::CommitOrder { commitment_hash: 0xABCD },
        )
    // Reveal window has not expired yet -> must revert "Reveal window not expired"
    let _: Wei = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SlashUnrevealed { batch_id: 1, commit_id: cid },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_slash_already_slashed() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 211)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 212)
    let bond = gwei(100_000)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), bond),
            salt: 213,
        )

    let cid: u256 = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: bond,
            message: FairBatchMsg::CommitOrder { commitment_hash: 0xDEAD01 },
        )
    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 3_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    let slasher = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 214)
    let first: Wei = evm
        .call(
            addr: slasher,
            gas: 800_000,
            value: Wei::zero(),
            message: TraderActorMsg::SlashOnExchange { exchange: fb, batch_id: 1, commit_id: cid },
        )
    assert!(first == bond)
    // Second slash on the same commitment must revert "Already slashed"!
    let _: Wei = evm
        .call(
            addr: slasher,
            gas: 800_000,
            value: Wei::zero(),
            message: TraderActorMsg::SlashOnExchange { exchange: fb, batch_id: 1, commit_id: cid },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_slash_revealed_commit() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 221)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 222)
    let bond = gwei(100_000)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), bond),
            salt: 223,
        )

    let alice = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 224)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: alice, amount: WAD },
        )
    let _: bool = evm
        .call(
            addr: alice,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: WAD },
        )
    let h = compute_commitment_hash(
        batch_id: 1,
        trader: alice,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 2_000 * WAD,
        salt: 0x9999,
    )
    let cid: u256 = evm
        .call(
            addr: alice,
            gas: 800_000,
            value: bond,
            message: TraderActorMsg::CommitOnExchange {
                exchange: fb,
                commitment_hash: h,
                bond_wei: bond,
            },
        )
    let _: u256 = evm
        .call(
            addr: alice,
            gas: 1_500_000,
            value: Wei::zero(),
            message: TraderActorMsg::RevealOnExchange {
                exchange: fb,
                commit_id: cid,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_000 * WAD,
                salt: 0x9999,
            },
        )
    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 3_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    // Slashing a revealed commitment must revert "Commitment was revealed"!
    let _: Wei = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SlashUnrevealed { batch_id: 1, commit_id: cid },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_order_cap_at_65th_order() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 231)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 232)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 233,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 100 * WAD },
        )

    var i: u256 = 0
    while i < MAX_ORDERS_PER_BATCH {
        let oid: u256 = evm
            .call(
                addr: fb,
                gas: 500_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitDirectOrder {
                    side: SELL_BASE,
                    amount_in: WAD / 10,
                    limit_price: 2_000 * WAD,
                },
            )
        assert!(oid == i)
        i = i + 1
    }

    // 65th order must revert "Batch order cap reached"!
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: WAD / 10,
                limit_price: 2_000 * WAD,
            },
        )
}

