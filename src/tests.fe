#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_replayed_eip712_intent() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 1)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 2)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 3,
        )

    let signer = Address::new(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: signer, spender: fb, amount: 10 * WAD },
        )

    let intent = SignedOrder {
        trader: signer,
        side: SELL_BASE,
        amount_in: 2 * WAD,
        limit_price: 2_500 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    let r: u256 = 0x3d91ca1cb1227ffff1c314806ed1193834496da813a9b80b4fb4246a9ac34dad
    let s: u256 = 0x65ddf4b5611599baed204d1eee244675b77972285801dc63de11a6a0eff6e3b6
    let v: u8 = 0x1c

    let first_id: u256 = evm
        .call(
            addr: fb,
            gas: 1_500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent {
                order: intent,
                signature: encode_packed((r, s, v)).as_bytes(),
            },
        )
    assert!(first_id == 0)
    // Replaying exact same signed order reverts because `nonces[signer]` is now 1!
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent {
                order: intent,
                signature: encode_packed((r, s, v)).as_bytes(),
            },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_expired_eip712_deadline() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 111)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 112)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 113,
        )

    let wallet = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 114)
    let now_secs = evm.timestamp().as_seconds()
    assert!(now_secs > 0)

    let expired = SignedOrder {
        trader: wallet,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 2_000 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(now_secs - 1),
    }
    let d: u256 = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeIntentDigest { order: expired },
        )
    let _: bool = evm
        .call(
            addr: wallet,
            gas: 200_000,
            value: Wei::zero(),
            message: TraderActorMsg::AuthorizeDigest { digest: d },
        )

    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent { order: expired, signature: Bytes::empty() },
        )
}

