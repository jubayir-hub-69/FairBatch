            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    // Submit 2 separate orders in Batch #1
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
