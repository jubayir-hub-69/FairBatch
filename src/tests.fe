                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
                lock_duration: seconds(3_600),
                min_shares: 0,
            },
        )
    // Attempting to withdraw locked LP shares before `unlock_time` must revert!
    let _: (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::RemoveLiquidity { shares: locked, min_base: 0, min_quote: 0 },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn evm_faucet_claim_transfers_exact_amounts_and_tracks_cooldown()
uses (evm: mut Evm)
{
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 171)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 172)
    let base_drip = WAD // 1 fWETH
    let quote_drip: u256 = 100_000_000 // 100 fUSDC (6 decimals)
    let cooldown = seconds(43_200) // 12 hours

    let faucet = evm
        .create2<Faucet>(
            value: Wei::zero(),
            args: (weth, usdc, base_drip, quote_drip, cooldown),
            salt: 173,
        )

    // Fund faucet with 2,000 fWETH and 1,000,000 fUSDC
    let fund_base = 2_000 * WAD
    let fund_quote: u256 = 1_000_000_000_000
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: faucet, amount: fund_base },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: faucet, amount: fund_quote },
        )

    let cfg: FaucetConfigInfo = evm
        .call(
            addr: faucet,
            gas: 300_000,
            value: Wei::zero(),
            message: FaucetMsg::GetConfig {},
        )
    assert!(cfg.base_token == weth)
    assert!(cfg.quote_token == usdc)
    assert!(cfg.base_amount == base_drip)
    assert!(cfg.quote_amount == quote_drip)
    assert!(cfg.cooldown == cooldown)

    let me = evm.address()
    let before_status: FaucetUserStatus = evm
        .call(
            addr: faucet,
            gas: 300_000,
            value: Wei::zero(),
            message: FaucetMsg::GetUserStatus { user: me },
        )
    assert!(before_status.can_claim)
    assert!(before_status.last_claim.as_seconds() == 0)

    let now = evm.timestamp()
    let (got_base, got_quote): (u256, u256) = evm
        .call(
            addr: faucet,
            gas: 500_000,
            value: Wei::zero(),
            message: FaucetMsg::Claim {},
        )
    assert!(got_base == base_drip)
    assert!(got_quote == quote_drip)

    let user_weth: u256 = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    let user_usdc: u256 = evm
        .call(
            addr: usdc,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    assert!(user_weth == base_drip)
    assert!(user_usdc == quote_drip)

    let rem_weth: u256 = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: faucet },
        )
    let rem_usdc: u256 = evm
        .call(
            addr: usdc,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: faucet },
        )
    assert!(rem_weth == fund_base - base_drip)
    assert!(rem_usdc == fund_quote - quote_drip)

    let after_status: FaucetUserStatus = evm
        .call(
            addr: faucet,
            gas: 300_000,
            value: Wei::zero(),
            message: FaucetMsg::GetUserStatus { user: me },
        )
    assert!(!after_status.can_claim)
    assert!(after_status.last_claim == now)
    assert!(after_status.next_claim_at == now + cooldown)

    let can_now: bool = evm
        .call(
            addr: faucet,
            gas: 200_000,
            value: Wei::zero(),
            message: FaucetMsg::CanClaim { user: me },
        )
    assert!(!can_now)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_faucet_double_claim_during_cooldown() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 181)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 182)
    let faucet = evm
        .create2<Faucet>(
            value: Wei::zero(),
            args: (weth, usdc, WAD, 100_000_000, seconds(43_200)),
            salt: 183,
        )

    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: faucet, amount: 10 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: faucet, amount: 1_000_000_000 },
        )

    let _: (u256, u256) = evm
        .call(
            addr: faucet,
            gas: 500_000,
            value: Wei::zero(),
            message: FaucetMsg::Claim {},
        )
    // Immediate second claim during 12h cooldown must revert!
    let _: (u256, u256) = evm
        .call(
            addr: faucet,
            gas: 500_000,
            value: Wei::zero(),
            message: FaucetMsg::Claim {},
        )
}

