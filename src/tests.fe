        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let shares: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )
    // Half of shares yields ~150,000 fUSDC -> asking for min_quote = 200,000 fUSDC must revert!
    let _: (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::RemoveLiquidity {
                shares: shares / 2,
                min_base: 0,
                min_quote: 200_000_000_000,
            },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn evm_token_owner_and_authorized_minter_succeed() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 351)
    let minter_actor = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 352)
    let recipient = Address::new(0xBEEF01)

    let owner: Address = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::Owner {},
        )
    assert!(owner == evm.address())

    let _: bool = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::SetMinter { account: minter_actor },
        )
    let configured_minter: Address = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::Minter {},
        )
    assert!(configured_minter == minter_actor)

    // Authorized minter (e.g. Faucet contract) can call `mint`!
    let ok: bool = evm
        .call(
            addr: minter_actor,
            gas: 400_000,
            value: Wei::zero(),
            message: TraderActorMsg::MintToken { token: weth, to: recipient, amount: 5 * WAD },
        )
    assert!(ok)
    let bal: u256 = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: recipient },
        )
    assert!(bal == 5 * WAD)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_unauthorized_token_mint() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 361)
    let attacker = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 362)

    // Unauthorized caller cannot mint tokens!
    let _: bool = evm
        .call(
            addr: attacker,
            gas: 400_000,
            value: Wei::zero(),
            message: TraderActorMsg::MintToken { token: weth, to: attacker, amount: 1_000 * WAD },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_unauthorized_token_blacklist() uses (evm: mut Evm) {
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 371)
    let attacker = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 372)

    // Unauthorized caller cannot blacklist any address!
    let _: bool = evm
        .call(
            addr: attacker,
            gas: 400_000,
            value: Wei::zero(),
            message: TraderActorMsg::SetTokenBlacklisted {
                token: usdc,
                account: Address::new(0x1234),
                blocked: true,
            },
        )
}

#[test]
fn pure_clearing_equal_prices_and_tiny_amounts_rounding() {
    let rx = 100 * WAD
    let ry = 300_000_000_000 // 300,000 fUSDC (6 decimals)

    // 1. Equal limit prices matching exact pool spot price ($3,000):
    //    Seller asks 3,000, Buyer bids 3,000 (asymmetric sizes) -> p* pinned at 3,000, exact balance.
    var eq_orders: MemVec<Order> = MemVec::new()
    eq_orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xC1,
                side: SELL_BASE,
                amount_in: 3 * WAD,
                limit_price: 3_000 * WAD,
            ),
        )
    eq_orders
        .push(
            make_order(
                id: 1,
                trader_id: 0xC2,
                side: BUY_BASE,
                amount_in: 9_000_000_000,
                limit_price: 3_000 * WAD,
            ),
        )
    let out_eq = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 6,
        orders: eq_orders.as_slice(),
    )
    assert!(out_eq.clearing_price == Wad::from_int(3_000))
    assert!(out_eq.fills[0].amount_filled == 3 * WAD)
    assert!(out_eq.fills[0].payout_out == 9_000_000_000)
    assert!(out_eq.fills[1].amount_filled == 9_000_000_000)
    assert!(out_eq.fills[1].payout_out == 3 * WAD)
    assert!(
        out_eq.reserve_base_after_raw == rx && out_eq.reserve_quote_after_raw == ry,
    )

    // 2. Non-crossing orders in hybrid pool (both OTM against spot $3,000):
    //    Seller asks $3,500, Buyer bids $2,500 -> 0 fills, 100% refunds, spot preserved!
    var no_cross: MemVec<Order> = MemVec::new()
    no_cross
        .push(
            make_order(
                id: 0,
                trader_id: 0xC3,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 3_500 * WAD,
            ),
        )
    no_cross
        .push(
            make_order(
                id: 1,
                trader_id: 0xC4,
                side: BUY_BASE,
                amount_in: 5_000_000_000,
                limit_price: 2_500 * WAD,
            ),
        )
    let out_nc = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 6,
        orders: no_cross.as_slice(),
    )
    assert!(out_nc.clearing_price == Wad::from_int(3_000))
    assert!(
        out_nc.fills[0].amount_filled == 0 && out_nc.fills[0].refund_in == 2 * WAD,
    )
    assert!(
        out_nc.fills[1].amount_filled == 0 && out_nc.fills[1].refund_in == 5_000_000_000,
    )
    assert!(
        out_nc.reserve_base_after_raw == rx && out_nc.reserve_quote_after_raw == ry,
    )

    // 3. Equal limit prices in Pure P2P with asymmetric volumes (pro-rata rationing at p* = 3,000)
    var p2p_eq: MemVec<Order> = MemVec::new()
    p2p_eq
        .push(
            make_order(
                id: 0,
                trader_id: 0xC5,
                side: SELL_BASE,
                amount_in: 10 * WAD,
                limit_price: 3_000 * WAD,
            ),
        )
    p2p_eq
        .push(
            make_order(
                id: 1,
                trader_id: 0xC6,
                side: BUY_BASE,
                amount_in: 9_000_000_000,
                limit_price: 3_000 * WAD,
            ),
        )
    let out_p2p = solve_batch(
        rx_raw: 0,
        ry_raw: 0,
        base_decimals: 18,
        quote_decimals: 6,
        orders: p2p_eq.as_slice(),
    )
    assert!(out_p2p.clearing_price == Wad::from_int(3_000))
    assert!(
        out_p2p.fills[0].amount_filled == 3 * WAD && out_p2p.fills[0].refund_in == 7 * WAD,
    )
    assert!(
        out_p2p.fills[1].amount_filled == 9_000_000_000 && out_p2p.fills[1].payout_out == 3 * WAD,
    )

    // 4. Tiny non-dust amount on 18d/6d (1_000 raw micro-USDC = $0.001 buys ~333_333_333_333 wei fWETH)
    var tiny: MemVec<Order> = MemVec::new()
    tiny.push(
        make_order(
            id: 0,
            trader_id: 0xC7,
            side: BUY_BASE,
            amount_in: 1_000,
            limit_price: 3_500 * WAD,
        ),
    )
    let out_tiny = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 6,
        orders: tiny.as_slice(),
    )
    assert!(out_tiny.fills[0].amount_filled == 1_000)
    assert!(out_tiny.fills[0].payout_out > 0)
    assert!(
        verify_lnd_invariant(
            rx_before: normalize_amount(rx, 18),
            ry_before: normalize_amount(ry, 6),
            rx_after: normalize_amount(out_tiny.reserve_base_after_raw, 18),
            ry_after: normalize_amount(out_tiny.reserve_quote_after_raw, 6),
        ),
    )
}
