#[test]
fn effect_mocked_clock_transitions() {
    let cfg = MarketConfig {
        base_token: Address::new(1),
        quote_token: Address::new(2),
        base_decimals: 18,
        quote_decimals: 6,
        commit_window: seconds(60),
        reveal_window: seconds(60),
        min_bond: ether(1),
    }
    let meta = BatchMeta {
        start_time: Timestamp::from_seconds(1_000),
        commit_deadline: Timestamp::from_seconds(1_060),
        reveal_deadline: Timestamp::from_seconds(1_120),
        order_count: 0,
        commit_count: 0,
        revealed_count: 0,
        settled: false,
    }

    with (BatchClock = MockClock { ts: Timestamp::from_seconds(1_030) }) {
        assert!(evaluate_batch_phase(meta, cfg) == PHASE_OPEN)
        assert_open_window(meta)
        assert_intent_window(meta)
    }

    with (BatchClock = MockClock { ts: Timestamp::from_seconds(1_090) }) {
        assert!(evaluate_batch_phase(meta, cfg) == PHASE_REVEAL)
        assert_reveal_window(meta, cfg)
        assert_intent_window(meta)
    }

    with (BatchClock = MockClock { ts: Timestamp::from_seconds(1_121) }) {
        assert!(evaluate_batch_phase(meta, cfg) == PHASE_READY_TO_SETTLE)
        assert_settlement_window(meta, cfg)
    }

    let settled_meta = BatchMeta {
        start_time: meta.start_time,
        commit_deadline: meta.commit_deadline,
        reveal_deadline: meta.reveal_deadline,
        order_count: 2,
        commit_count: 1,
        revealed_count: 1,
        settled: true,
    }
    with (BatchClock = MockClock { ts: Timestamp::from_seconds(1_200) }) {
        assert!(
            evaluate_batch_phase(meta: settled_meta, cfg) == PHASE_SETTLED,
        )
    }
}

#[test]
fn pure_commitment_hash_determinism_and_sensitivity() {
    let trader = Address::new(0xCAFE)
    let h0 = compute_commitment_hash(
        batch_id: 1,
        trader,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 3_000 * WAD,
        salt: 0x123456,
    )
    let h_same = compute_commitment_hash(
        batch_id: 1,
        trader,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 3_000 * WAD,
        salt: 0x123456,
    )
    assert!(h0 == h_same)

    // Changing any field changes the commitment hash
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 2,
                trader,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 3_000 * WAD,
                salt: 0x123456,
            ),
    )
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 1,
                trader: Address::new(0xCAFF),
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 3_000 * WAD,
                salt: 0x123456,
            ),
    )
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 1,
                trader,
                side: BUY_BASE,
                amount_in: WAD,
                limit_price: 3_000 * WAD,
                salt: 0x123456,
            ),
    )
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 1,
                trader,
                side: SELL_BASE,
                amount_in: WAD + 1,
                limit_price: 3_000 * WAD,
                salt: 0x123456,
            ),
    )
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 1,
                trader,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 3_000 * WAD + 1,
                salt: 0x123456,
            ),
    )
    assert!(
        h0
            != compute_commitment_hash(
                batch_id: 1,
                trader,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 3_000 * WAD,
                salt: 0x123457,
            ),
    )
}

#[test]
fn eip712_ecdsa_recover_and_tamper_rejection() uses (_evm: Evm) {
    let trader = Address::new(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
    let sep = domain_separator(
        name_hash: EIP712_NAME_HASH,
        version_hash: EIP712_VERSION_HASH,
        chain_id: 31337,
        verifying_contract: Address::new(0xfa12ba7c),
    )
    assert!(
        sep == 0x3a235f870b2c4bafee7ad1a5b63f8cbaab291d0a7a27f22c3fe172d53c1c01f5,
    )

    let order = SignedOrder {
        trader,
        side: SELL_BASE,
        amount_in: 2 * WAD,
        limit_price: 2_900 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    assert!(
        hash_signed_order(order)
            == 0x72377c2b7a32710fef52052f14382d28b79f4fb8cb993f1f152014c877f349bc,
    )

    let r: u256 = 0xf38b542e2186e128524844f45ba4097cc612ca5693553a551bd852a39864b001
    let s: u256 = 0x46bb54daf0e46947904cb054de1bd275ff54127c5fa67b0cad44b4c4eecd474c
    let v: u8 = 0x1b
    let sig = encode_packed((r, s, v)).as_bytes()

    match recover_order_signer(domain_separator: sep, order, signature: sig) {
        Option::Some(recovered) => {
            assert!(recovered == trader)
        },
        Option::None => {
            assert!(false, "Expected valid secp256k1 signature recovery")
        },
    }

    // Tampering with limit_price recovers a different random address != trader
    let tampered = SignedOrder {
        trader,
        side: SELL_BASE,
        amount_in: 2 * WAD,
        limit_price: 2_800 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    match recover_order_signer(domain_separator: sep, order: tampered, signature: sig) {
        Option::Some(recovered) => {
            assert!(recovered != trader)
        },
        Option::None => {},
    }
}

