struct MockClock { ts: Timestamp }

impl Copy for MockClock {}

impl BatchClock for MockClock {
    fn now(self) -> Timestamp {
        self.ts
    }
}

/// Multi-user trader & ERC-1271 smart wallet actor for EVM integration tests.
msg TraderActorMsg {
    #[selector = sol("approveToken(address,address,uint256)")]
    ApproveToken { token: Address, spender: Address, amount: u256 } -> bool,

    #[selector = sol("submitDirect(address,uint8,uint256,uint256)")]
    SubmitDirect { exchange: Address, side: u8, amount_in: u256, limit_price: u256 } -> u256,

    #[selector = sol("commitOnExchange(address,uint256,uint256)")]
    CommitOnExchange { exchange: Address, commitment_hash: u256, bond_wei: Wei } -> u256,

    #[selector = sol(
        "revealOnExchange(address,uint256,uint8,uint256,uint256,uint256)",
    )]
    RevealOnExchange {
        exchange: Address,
        commit_id: u256,
        side: u8,
        amount_in: u256,
        limit_price: u256,
        salt: u256,
    } -> u256,

    #[selector = sol("claimOnExchange(address,uint256,uint256)")]
    ClaimOnExchange { exchange: Address, batch_id: u256, order_id: u256 } -> (u256, u256),

    #[selector = sol("slashOnExchange(address,uint256,uint256)")]
    SlashOnExchange { exchange: Address, batch_id: u256, commit_id: u256 } -> Wei,

    #[selector = sol(
        "relaySignedIntent(address,(address,uint8,uint256,uint256,uint256,uint256,uint256),bytes)",
    )]
    RelaySignedIntent { exchange: Address, order: SignedOrder, signature: Bytes } -> u256,

    #[selector = sol("authorizeDigest(uint256)")]
    AuthorizeDigest { digest: u256 } -> bool,

    #[selector = sol("isValidSignature(bytes32,bytes)")]
    IsValidSignature { digest: Bytes32, signature: Bytes } -> u256,

    #[selector = sol("refundCount()")]
    RefundCount -> u256,

    #[selector = sol("mintToken(address,address,uint256)")]
    MintToken { token: Address, to: Address, amount: u256 } -> bool,

    #[selector = sol("setTokenBlacklisted(address,address,bool)")]
    SetTokenBlacklisted { token: Address, account: Address, blocked: bool } -> bool,
}

contract TraderActor uses (call: mut Call) {
    mut approved_digest: u256,
    mut refund_count: u256,

    init()
    uses (mut approved_digest, mut refund_count)
    {
        approved_digest = 0
        refund_count = 0
    }

    recv TraderActorMsg {
        ApproveToken { token, spender, amount } -> bool
        uses (mut call)
        {
            call.call(
                addr: token,
                gas: 200_000,
                value: Wei::zero(),
                message: MockErc20Msg::Approve { spender, amount },
            )
        }

        SubmitDirect { exchange, side, amount_in, limit_price } -> u256
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 800_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitDirectOrder { side, amount_in, limit_price },
            )
        }

        #[payable]
        CommitOnExchange { exchange, commitment_hash, bond_wei } -> u256
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 500_000,
                value: bond_wei,
                message: FairBatchMsg::CommitOrder { commitment_hash },
            )
        }

        RevealOnExchange { exchange, commit_id, side, amount_in, limit_price, salt } -> u256
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 1_200_000,
                value: Wei::zero(),
                message: FairBatchMsg::RevealOrder {
                    commit_id,
                    side,
                    amount_in,
                    limit_price,
                    salt,
                },
            )
        }

        ClaimOnExchange { exchange, batch_id, order_id } -> (u256, u256)
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 800_000,
                value: Wei::zero(),
                message: FairBatchMsg::Claim { batch_id, order_id },
            )
        }

        SlashOnExchange { exchange, batch_id, commit_id } -> Wei
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 800_000,
                value: Wei::zero(),
                message: FairBatchMsg::SlashUnrevealed { batch_id, commit_id },
            )
        }

        RelaySignedIntent { exchange, order, signature } -> u256
        uses (mut call)
        {
            call.call(
                addr: exchange,
                gas: 1_000_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitSignedIntent { order, signature },
            )
        }

        AuthorizeDigest { digest } -> bool uses (mut approved_digest) {
            approved_digest = digest
            true
        }

        IsValidSignature { digest, signature } -> u256
        uses (approved_digest)
        {
            let _ = signature
            if approved_digest != 0 && digest.word() == approved_digest {
                // ERC-1271 magic value `0x1626ba7e` left-aligned in 32-byte word
                0x1626ba7e00000000000000000000000000000000000000000000000000000000
            } else {
                0xffffffff00000000000000000000000000000000000000000000000000000000
            }
        }

        RefundCount -> u256 uses (refund_count) {
            refund_count
        }

        MintToken { token, to, amount } -> bool uses (mut call) {
            call.call(
                addr: token,
                gas: 300_000,
                value: Wei::zero(),
                message: MockErc20Msg::Mint { to, amount },
            )
        }

        SetTokenBlacklisted { token, account, blocked } -> bool
        uses (mut call)
        {
            call.call(
                addr: token,
                gas: 300_000,
                value: Wei::zero(),
                message: MockErc20Msg::SetBlacklisted { account, blocked },
            )
        }
    }

    recv {
        #[payable]
        _ uses (mut refund_count) {
            // Performs an SSTORE (> 2,300 gas stipend) so bond refund tests
            // catch regressions against smart wallets and EIP-7702 accounts.
            refund_count = refund_count + 1
        }
    }
}

/// Adversarial ERC-20 token that attempts a reentrant callback into `FairBatch`
/// during `transfer`, verifying that `std::evm::mutex::Mutex` (`TLOAD`/`TSTORE`)
/// blocks reentrancy immediately.
msg ReentrantTokenAdminMsg {
    #[selector = sol("armAttack(address,uint256,uint256)")]
    ArmAttack { target: Address, batch_id: u256, order_id: u256 } -> bool,
}

contract MaliciousReentrantERC20 uses (ctx: Ctx, call: mut Call) {
    mut balances: StorageMap<Address, u256>,
    mut allowances: StorageMap<(Address, Address), u256>,
    mut target_exchange: Address,
    mut attack_batch: u256,
    mut attack_order: u256,
    mut armed: bool,

    init() uses (mut armed) { armed = false }

    recv ReentrantTokenAdminMsg {
        ArmAttack { target, batch_id, order_id } -> bool
        uses (mut target_exchange, mut attack_batch, mut attack_order, mut armed)
        {
            target_exchange = target
            attack_batch = batch_id
            attack_order = order_id
            armed = true
            true
        }
    }

    recv MockErc20Msg {
        Decimals -> u8 {
            18
        }

        TotalSupply -> u256 {
            0
        }

        BalanceOf { account } -> u256 uses (balances) {
            balances.get(key: account)
        }

        Allowance { owner, spender } -> u256 uses (allowances) {
            allowances.get(key: (owner, spender))
        }

        Owner -> Address {
            Address::zero()
        }

        Minter -> Address {
            Address::zero()
        }

        Transfer { to, amount } -> bool uses (
            ctx,
            mut call,
            mut balances,
            target_exchange,
            attack_batch,
            attack_order,
            mut armed,
        ) {
            let sender = ctx.caller()
            let bal = balances.get(key: sender)
            assert!(bal >= amount, "Insufficient balance")
            balances.set(key: sender, value: bal - amount)
            balances.set(key: to, value: balances.get(key: to) + amount)

            if armed {
                armed = false
                // Attempt reentrant call into `FairBatch` while `guard.lock()` is held!
                let _: (u256, u256) = call
                    .call(
                        addr: target_exchange,
                        gas: 500_000,
                        value: Wei::zero(),
                        message: FairBatchMsg::Claim {
                            batch_id: attack_batch,
                            order_id: attack_order,
                        },
                    )
            }
            true
        }

        Approve { spender, amount } -> bool uses (ctx, mut allowances) {
            allowances.set(key: (ctx.caller(), spender), value: amount)
            true
        }

        TransferFrom { from, to, amount } -> bool
        uses (ctx, mut balances, mut allowances)
        {
            let spender = ctx.caller()
            let allowed = allowances.get(key: (from, spender))
            assert!(allowed >= amount, "Insufficient allowance")
            let bal = balances.get(key: from)
            assert!(bal >= amount, "Insufficient balance")
            allowances.set(key: (from, spender), value: allowed - amount)
            balances.set(key: from, value: bal - amount)
            balances.set(key: to, value: balances.get(key: to) + amount)
            true
        }

        Mint { to, amount } -> bool uses (mut balances) {
            balances.set(key: to, value: balances.get(key: to) + amount)
            true
        }

        MintAndApprove { owner, spender, amount } -> bool
        uses (mut balances, mut allowances)
        {
            balances.set(key: owner, value: balances.get(key: owner) + amount)
            allowances
                .set(
                    key: (owner, spender),
                    value: allowances.get(key: (owner, spender)) + amount,
                )
            true
        }

        SetMinter { account } -> bool {
            let _ = account
            true
        }

        SetBlacklisted { account, blocked } -> bool {
            let _ = account
            let _ = blocked
            true
        }
    }
}

fn make_order(id: u256, trader_id: u256, side: u8, amount_in: u256, limit_price: u256) -> Order {
    Order {
        order_id: id,
        trader: Address::new(trader_id),
        side,
        amount_in,
        limit_price,
        mode: MODE_DIRECT,
    }
}

// ============================================================================
// Group A: Pure Clearing & Equilibrium Math Unit Tests (`uses ()`)
// ============================================================================

#[test]
fn pure_five_eth_sellers_uniform_price() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x11,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_000 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x12,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_100 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x13,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_200 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 3,
                trader_id: 0x14,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_300 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 4,
                trader_id: 0x15,
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_400 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    // p* = 300,000 / (100 + 2*5) = 2727.272727272727272727 Wad
    let expected_p = (300_000 * WAD) / 110
    assert!(out.clearing_price.raw() == expected_p)
    assert!(out.total_sell_base_raw == 5 * WAD)
    assert!(out.total_buy_quote_raw == 0)
    assert!(out.cow_matched_base_norm == 0)

    var i: usize = 0
    while i < 5 {
        let f = out.fills[i]
        assert!(f.amount_filled == WAD)
        assert!(f.payout_out == expected_p)
        assert!(f.refund_in == 0)
        i = i + 1
    }

    // Strict LND growth: R_x' * R_y' > R_x * R_y on imbalanced flow
    assert!(out.reserve_base_after_raw == 105 * WAD)
    assert!(
        out.reserve_quote_after_raw * out.reserve_base_after_raw > rx * ry,
    )
}

#[test]
fn pure_cow_balanced_zero_slippage() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x21,
                side: SELL_BASE,
                amount_in: 5 * WAD,
                limit_price: 2_900 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x22,
                side: BUY_BASE,
                amount_in: 15_000 * WAD,
                limit_price: 3_100 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::from_int(3_000))
    assert!(out.cow_matched_base_norm == 5 * WAD)
    assert!(out.cow_matched_quote_norm == 15_000 * WAD)
    assert!(out.reserve_base_after_raw == rx)
    assert!(out.reserve_quote_after_raw == ry)
    assert!(out.fills[0].payout_out == 15_000 * WAD)
    assert!(out.fills[1].payout_out == 5 * WAD)
}

#[test]
fn pure_p2p_zero_reserves_crossing() {
    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x31,
                side: SELL_BASE,
                amount_in: 4 * WAD,
                limit_price: 2_800 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x32,
                side: BUY_BASE,
                amount_in: 12_000 * WAD,
                limit_price: 3_200 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: 0,
        ry_raw: 0,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::from_int(3_000))
    assert!(out.total_sell_base_raw == 4 * WAD)
    assert!(out.total_buy_quote_raw == 12_000 * WAD)
    assert!(out.cow_matched_base_norm == 4 * WAD)
    assert!(out.reserve_base_after_raw == 0)
    assert!(out.reserve_quote_after_raw == 0)
    assert!(out.fills[0].payout_out == 12_000 * WAD)
    assert!(out.fills[1].payout_out == 4 * WAD)
}

#[test]
fn pure_p2p_rounding_solvency_stress() {
    // Non-terminating ratio 10 / 6 = 1.666666666666666666... Wad:
    // Without pure-P2P solvency capping, floor(10e18 * 1e18 / 1666666666666666666)
    // would exceed 6e18 by 2 wei! Verify FairBatch never over-allocates even 1 wei.
    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x41,
                side: SELL_BASE,
                amount_in: 3 * WAD,
                limit_price: WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x42,
                side: SELL_BASE,
                amount_in: 3 * WAD,
                limit_price: WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x43,
                side: BUY_BASE,
                amount_in: 5 * WAD,
                limit_price: 2 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 3,
                trader_id: 0x44,
                side: BUY_BASE,
                amount_in: 5 * WAD,
                limit_price: 2 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: 0,
        ry_raw: 0,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    let seller_quote_sum = out.fills[0].payout_out + out.fills[1].payout_out
    let buyer_base_sum = out.fills[2].payout_out + out.fills[3].payout_out
    assert!(seller_quote_sum <= 10 * WAD)
    assert!(buyer_base_sum <= 6 * WAD && buyer_base_sum >= 6 * WAD - 2)
}

#[test]
fn regression_counterexample_a_buyer_denominator_lnd() {
    // Counterexample A from Philogy/Marius audit (#17):
    // rx = 3*WAD, ry = 10_000*WAD, Seller 30_000*WAD @ 0, Buyer 100_000_000*WAD @ 5_000*WAD.
    // Verifies directional `p_buy = max(p_star, p_exec_ceil)` prevents buyer over-allocation
    // and strictly preserves `k_after >= k_before`.
    let rx = 3 * WAD
    let ry = 10_000 * WAD

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xE1,
                side: SELL_BASE,
                amount_in: 30_000 * WAD,
                limit_price: 0,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0xE2,
                side: BUY_BASE,
                amount_in: 100_000_000 * WAD,
                limit_price: 5_000 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price.raw() == 3_333_333_333_333_333_333_333)
    assert!(out.fills[1].payout_out <= 30_000 * WAD)
    assert!(
        verify_lnd_invariant(
            rx_before: rx,
            ry_before: ry,
            rx_after: out.reserve_base_after_raw,
            ry_after: out.reserve_quote_after_raw,
        ),
    )
    assert!(
        out.reserve_base_after_raw >= rx && out.reserve_quote_after_raw >= ry,
    )
}

#[test]
fn regression_counterexample_b_tiny_reserve_base_solvency() {
    // Counterexample B (#17): rx = 1 wei, ry = 3_333 wei, Seller 30_000*WAD @ 0, Buyer 100_000_000*WAD @ 5_000*WAD.
    // Verifies Base solvency (`buyer_payout <= rx + sx`) and 512-bit LND invariant hold strictly.
    let rx: u256 = 1
    let ry: u256 = 3_333

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xE3,
                side: SELL_BASE,
                amount_in: 30_000 * WAD,
                limit_price: 0,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0xE4,
                side: BUY_BASE,
                amount_in: 100_000_000 * WAD,
                limit_price: 5_000 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.fills[1].payout_out <= rx + 30_000 * WAD)
    assert!(
        verify_lnd_invariant(
            rx_before: rx,
            ry_before: ry,
            rx_after: out.reserve_base_after_raw,
            ry_after: out.reserve_quote_after_raw,
        ),
    )
}

#[test]
fn regression_counterexample_c_marginal_pro_rata_spot_pin_lnd() {
    // Counterexample C (#17): rx = 100*WAD, ry = 100*WAD, 1 Seller 30_000*WAD @ 0.9*WAD,
    // 7 Buyers 5_000*WAD each @ 1.0*WAD. Pro-rata buyer floor leaves `total_buy_filled = 30_000*WAD - 5`.
    // Verifies `p_sell = min(p_star, p_exec_floor)` adjusts seller Quote payout so `k_after >= k_before`.
    let rx = 100 * WAD
    let ry = 100 * WAD

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xE5,
                side: SELL_BASE,
                amount_in: 30_000 * WAD,
                limit_price: 900_000_000_000_000_000,
            ),
        )
    var b: u256 = 0
    while b < 7 {
        orders
            .push(
                make_order(
                    id: 1 + b,
                    trader_id: 0xF0 + b,
                    side: BUY_BASE,
                    amount_in: 5_000 * WAD,
                    limit_price: WAD,
                ),
            )
        b = b + 1
    }

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::one())
    assert!(out.total_buy_quote_raw == 30_000 * WAD - 5)
    assert!(
        verify_lnd_invariant(
            rx_before: rx,
            ry_before: ry,
            rx_after: out.reserve_base_after_raw,
            ry_after: out.reserve_quote_after_raw,
        ),
    )
    assert!(
        out.reserve_base_after_raw > rx && out.reserve_quote_after_raw > ry,
    )
}

#[test]
fn regression_dust_weth_to_6dec_usdc_zero_payout_refunded() {
    // 1,000 wei WETH (`MIN_ORDER_AMOUNT`) sold against 6-decimal USDC at $3,000/WETH
    // yields `0.000000000003` USDC (< 1 raw micro-USDC atom). Must be 100% refunded!
    let rx = 100 * WAD
    let ry = 300_000_000_000

    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0xEA,
                side: SELL_BASE,
                amount_in: 1_000,
                limit_price: 2_000 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 6,
        orders: orders.as_slice(),
    )

    assert!(out.fills[0].amount_filled == 0)
    assert!(out.fills[0].payout_out == 0)
    assert!(out.fills[0].refund_in == 1_000)
    assert!(out.reserve_base_after_raw == rx)
    assert!(out.reserve_quote_after_raw == ry)
}

#[test]
fn pure_p2p_one_sided_and_non_crossing_refunds() {
    // 1. One-sided pure P2P (`R_x = R_y = 0`, no buyers)
    var one_sided: MemVec<Order> = MemVec::new()
    one_sided
        .push(
            make_order(
                id: 0,
                trader_id: 0x51,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_500 * WAD,
            ),
        )
    let out1 = solve_batch(
        rx_raw: 0,
        ry_raw: 0,
        base_decimals: 18,
        quote_decimals: 18,
        orders: one_sided.as_slice(),
    )
    assert!(out1.clearing_price.is_zero())
    assert!(out1.fills[0].amount_filled == 0)
    assert!(out1.fills[0].refund_in == 2 * WAD)

    // 2. Non-crossing pure P2P (seller asks 3,200 > buyer bids 2,800)
    var uncrossed: MemVec<Order> = MemVec::new()
    uncrossed
        .push(
            make_order(
                id: 0,
                trader_id: 0x51,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 3_200 * WAD,
            ),
        )
    uncrossed
        .push(
            make_order(
                id: 1,
                trader_id: 0x52,
                side: BUY_BASE,
                amount_in: 5_000 * WAD,
                limit_price: 2_800 * WAD,
            ),
        )
    let out2 = solve_batch(
        rx_raw: 0,
        ry_raw: 0,
        base_decimals: 18,
        quote_decimals: 18,
        orders: uncrossed.as_slice(),
    )
    assert!(out2.clearing_price.is_zero())
    assert!(out2.fills[0].refund_in == 2 * WAD)
    assert!(out2.fills[1].refund_in == 5_000 * WAD)
}

#[test]
fn pure_empty_batch_preserves_reserves() {
    let rx = 100 * WAD
    let ry = 300_000_000_000
    let empty: MemVec<Order> = MemVec::new()

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 6,
        orders: empty.as_slice(),
    )
    assert!(out.clearing_price == Wad::from_int(3_000))
    assert!(out.total_sell_base_raw == 0)
    assert!(out.total_buy_quote_raw == 0)
    assert!(out.reserve_base_after_raw == rx)
    assert!(out.reserve_quote_after_raw == ry)
}

#[test]
fn pure_out_of_the_money_orders_full_refund() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    var orders: MemVec<Order> = MemVec::new()
    // ITM seller (2500 < 3000) & ITM buyer (3500 > 3000) matched at 3000
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x61,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_500 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x62,
                side: BUY_BASE,
                amount_in: 6_000 * WAD,
                limit_price: 3_500 * WAD,
            ),
        )
    // OTM seller (3400 > 3000) & OTM buyer (2600 < 3000) must get 0 fill, 100% refund
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x63,
                side: SELL_BASE,
                amount_in: 10 * WAD,
                limit_price: 3_400 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 3,
                trader_id: 0x64,
                side: BUY_BASE,
                amount_in: 20_000 * WAD,
                limit_price: 2_600 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::from_int(3_000))
    assert!(out.fills[0].amount_filled == 2 * WAD)
    assert!(out.fills[0].refund_in == 0)
    assert!(out.fills[1].amount_filled == 6_000 * WAD)
    assert!(out.fills[1].refund_in == 0)
    assert!(out.fills[2].amount_filled == 0)
    assert!(out.fills[2].payout_out == 0)
    assert!(out.fills[2].refund_in == 10 * WAD)
    assert!(out.fills[3].amount_filled == 0)
    assert!(out.fills[3].payout_out == 0)
    assert!(out.fills[3].refund_in == 20_000 * WAD)
}

#[test]
fn pure_marginal_seller_tier_pinning_pro_rata() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    // 4 sellers offering 2.5 ETH each (10 ETH total) with min price 2,800.
    // Full 10 ETH would push p* = 300,000 / 120 = 2,500 < 2,800.
    // Solver pins p* = 2,800 and fills ((300,000 / 2,800) - 100) / 2 = 3.571428571428571428 ETH pro-rata!
    var orders: MemVec<Order> = MemVec::new()
    let each = 2_500_000_000_000_000_000
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x71,
                side: SELL_BASE,
                amount_in: each,
                limit_price: 2_800 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x72,
                side: SELL_BASE,
                amount_in: each,
                limit_price: 2_800 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x73,
                side: SELL_BASE,
                amount_in: each,
                limit_price: 2_800 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 3,
                trader_id: 0x74,
                side: SELL_BASE,
                amount_in: each,
                limit_price: 2_800 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::from_int(2_800))
    let f0 = out.fills[0]
    let f1 = out.fills[1]
    let f2 = out.fills[2]
    let f3 = out.fills[3]
    // Identical pro-rata partial fills across all 4 equal sellers!
    assert!(f0.amount_filled > 0 && f0.amount_filled < each)
    assert!(f0.amount_filled == f1.amount_filled)
    assert!(f1.amount_filled == f2.amount_filled)
    assert!(f2.amount_filled == f3.amount_filled)
    assert!(f0.amount_filled + f0.refund_in == each)
}

#[test]
fn pure_marginal_buyer_tier_pinning_pro_rata() {
    let rx = 100 * WAD
    let ry = 300_000 * WAD

    // 3 buyers bidding 20,000 USDC each (60,000 USDC total) with max price 3,300.
    // Full 60,000 USDC would push p* = (300,000 + 120,000)/100 = 4,200 > 3,300.
    // Solver pins p* = 3,300 and fills ((3,300 * 100) - 300,000)/2 = 15,000 USDC total (5,000 each = 25%!).
    var orders: MemVec<Order> = MemVec::new()
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x81,
                side: BUY_BASE,
                amount_in: 20_000 * WAD,
                limit_price: 3_300 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x82,
                side: BUY_BASE,
                amount_in: 20_000 * WAD,
                limit_price: 3_300 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x83,
                side: BUY_BASE,
                amount_in: 20_000 * WAD,
                limit_price: 3_300 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw: rx,
        ry_raw: ry,
        base_decimals: 18,
        quote_decimals: 18,
        orders: orders.as_slice(),
    )

    assert!(out.clearing_price == Wad::from_int(3_300))
    assert!(out.total_buy_quote_raw == 15_000 * WAD)
    var i: usize = 0
    while i < 3 {
        assert!(out.fills[i].amount_filled == 5_000 * WAD)
        assert!(out.fills[i].refund_in == 15_000 * WAD)
        i = i + 1
    }
}

#[test]
fn pure_decimal_scaling_weth18_usdc6_solvency() {
    assert!(scale_factor(18) == 1)
    assert!(scale_factor(6) == 1_000_000_000_000)

    let rx_raw = 100 * WAD
    let ry_raw = 300_000_000_000 // 300,000 USDC (6 decimals)

    var orders: MemVec<Order> = MemVec::new()
    let s1 = 1_234_567_890_123_456_789
    let s2 = 2_718_281_828_459_045_235
    let b1 = 4_321_987_654 // 4,321.987654 USDC
    orders
        .push(
            make_order(
                id: 0,
                trader_id: 0x91,
                side: SELL_BASE,
                amount_in: s1,
                limit_price: 2_500 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 1,
                trader_id: 0x92,
                side: SELL_BASE,
                amount_in: s2,
                limit_price: 2_600 * WAD,
            ),
        )
    orders
        .push(
            make_order(
                id: 2,
                trader_id: 0x93,
                side: BUY_BASE,
                amount_in: b1,
                limit_price: 3_500 * WAD,
            ),
        )

    let out = solve_batch(
        rx_raw,
        ry_raw,
        base_decimals: 18,
        quote_decimals: 6,
        orders: orders.as_slice(),
    )

    // Verify exact raw atom conservation across 18-dec Base and 6-dec Quote:
    let total_base_in = rx_raw + s1 + s2
    let total_base_out = out.reserve_base_after_raw
        + out.fills[0].refund_in
        + out.fills[1].refund_in
        + out.fills[2].payout_out
    assert!(total_base_in == total_base_out)

    let total_quote_in = ry_raw + b1
    let total_quote_out = out.reserve_quote_after_raw
        + out.fills[0].payout_out
        + out.fills[1].payout_out
        + out.fills[2].refund_in
    assert!(total_quote_in == total_quote_out)
}

#[test]
fn pure_math_helpers_floor_rounding_and_price() {
    let price = Wad::from_raw(2_727_272_727_272_727_272_727)
    let q = quote_from_base_floor(base_norm: WAD, price)
    assert!(q == 2_727_272_727_272_727_272_727)
    let b = base_from_quote_floor(quote_norm: q, price)
    assert!(b <= WAD)
    assert!(
        compute_fm_amm_price(rx_norm: 0, ry_norm: 0, sx_norm: 0, dy_norm: 100).is_zero(),
    )
}

