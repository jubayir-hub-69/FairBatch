#[test(balance = 100_000_000_000_000_000_000)]
fn evm_basic_lifecycle_weth_usdc_6dec() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 1)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 2)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 3,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 200 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 500_000_000_000,
            },
        )

    let shares: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )
    assert!(shares > 0)

    let ord_id: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: 5 * WAD,
                limit_price: 2_500 * WAD,
            },
        )
    assert!(ord_id == 0)

    let summary: BatchSummary = evm
        .call(
            addr: fb,
            gas: 5_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(summary.settled)
    assert!(summary.clearing_price == (300_000 * WAD) / 110)

    let (claimed_weth, claimed_usdc): (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::Claim { batch_id: 1, order_id: 0 },
        )
    assert!(claimed_weth == 0)
    let expected_norm = mul_div(normalize_amount(5 * WAD, 18), summary.clearing_price, WAD)
    assert!(claimed_usdc == denormalize_floor(expected_norm, 6))
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_five_distinct_traders_uniform_execution() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 11)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 12)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 13,
        )

    let lp = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: lp, spender: fb, amount: 100 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: lp,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    // Deploy 5 independent TraderActor accounts (Alice..Eve)
    var actors: MemVec<Address> = MemVec::new()
    var i: u256 = 0
    while i < 5 {
        let actor = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 100 + i)
        let _: bool = evm
            .call(
                addr: weth,
                gas: 300_000,
                value: Wei::zero(),
                message: MockErc20Msg::Mint { to: actor, amount: WAD },
            )
        let _: bool = evm
            .call(
                addr: actor,
                gas: 500_000,
                value: Wei::zero(),
                message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: WAD },
            )
        let oid: u256 = evm
            .call(
                addr: actor,
                gas: 1_200_000,
                value: Wei::zero(),
                message: TraderActorMsg::SubmitDirect {
                    exchange: fb,
                    side: SELL_BASE,
                    amount_in: WAD,
                    limit_price: (2_000 + i * 100) * WAD,
                },
            )
        assert!(oid == i)
        actors.push(actor)
        i = i + 1
    }

    let summary: BatchSummary = evm
        .call(
            addr: fb,
            gas: 6_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(summary.order_count == 5)
    assert!(summary.clearing_price == (300_000 * WAD) / 110)

    // Every single trader claims and receives the EXACT same 6-decimal USDC balance (2,727.272727 USDC)!
    var idx: usize = 0
    while idx < 5 {
        let actor = actors[idx]
        let (out_base, out_quote): (u256, u256) = evm
            .call(
                addr: actor,
                gas: 1_200_000,
                value: Wei::zero(),
                message: TraderActorMsg::ClaimOnExchange {
                    exchange: fb,
                    batch_id: 1,
                    order_id: idx as u256,
                },
            )
        assert!(out_base == 0)
        assert!(out_quote == 2_727_272_727)

        let usdc_bal: u256 = evm
            .call(
                addr: usdc,
                gas: 200_000,
                value: Wei::zero(),
                message: MockErc20Msg::BalanceOf { account: actor },
            )
        assert!(usdc_bal == 2_727_272_727)
        idx = idx + 1
    }
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_commit_reveal_bond_refund_and_unrevealed_slashing() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 21)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 22)
    let bond_req = gwei(100_000_000) // 0.1 ETH reveal bond
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), bond_req),
            salt: 23,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 110 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    // 1. Honest trader (`alice`) commits & reveals -> receives 0.1 ETH bond back!
    let alice = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 25)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: alice, amount: 2 * WAD },
        )
    let _: bool = evm
        .call(
            addr: alice,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: 2 * WAD },
        )

    let honest_hash: u256 = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeCommitmentHash {
                batch_id: 1,
                trader: alice,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_500 * WAD,
                salt: 0xAA11CE,
            },
        )
    let c0: u256 = evm
        .call(
            addr: alice,
            gas: 800_000,
            value: bond_req,
            message: TraderActorMsg::CommitOnExchange {
                exchange: fb,
                commitment_hash: honest_hash,
                bond_wei: bond_req,
            },
        )
    assert!(c0 == 0)
    assert!(evm.balance(fb) == bond_req)
    assert!(evm.balance(alice) == Wei::zero())

    let ord0: u256 = evm
        .call(
            addr: alice,
            gas: 1_500_000,
            value: Wei::zero(),
            message: TraderActorMsg::RevealOnExchange {
                exchange: fb,
                commit_id: c0,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_500 * WAD,
                salt: 0xAA11CE,
            },
        )
    assert!(ord0 == 0)
    assert!(evm.balance(alice) == bond_req)
    assert!(evm.balance(fb) == Wei::zero())
    let refunds: u256 = evm
        .call(
            addr: alice,
            gas: 200_000,
            value: Wei::zero(),
            message: TraderActorMsg::RefundCount {},
        )
    assert!(refunds == 1)

    // 2. Griefer (`mallory`) commits with 0.1 ETH bond and withholds reveal!
    let mallory = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 24)
    let c1: u256 = evm
        .call(
            addr: mallory,
            gas: 800_000,
            value: bond_req,
            message: TraderActorMsg::CommitOnExchange {
                exchange: fb,
                commitment_hash: 0xDEADBEEF1234,
                bond_wei: bond_req,
            },
        )
    assert!(c1 == 1)

    // Settle Batch #1, then slash Mallory's unrevealed commitment via a permissionless slasher!
    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    let slasher = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 26)
    assert!(evm.balance(fb) == bond_req)
    assert!(evm.balance(slasher) == Wei::zero())
    let forfeited: Wei = evm
        .call(
            addr: slasher,
            gas: 1_000_000,
            value: Wei::zero(),
            message: TraderActorMsg::SlashOnExchange { exchange: fb, batch_id: 1, commit_id: c1 },
        )
    assert!(forfeited == bond_req)
    assert!(evm.balance(slasher) == bond_req)
    assert!(evm.balance(fb) == Wei::zero())

    let comm_state: Commitment = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetCommitment { batch_id: 1, commit_id: c1 },
        )
    assert!(comm_state.slashed)
    assert!(!comm_state.revealed)
    assert!(comm_state.bond == Wei::zero())
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_eip712_eoa_signed_intent_gasless_relayer() uses (evm: mut Evm) {
    // Deploy with salts (1, 2, 3) so FairBatch sits at deterministic CREATE2 address
    // `0xcd417526890a5446Bf501F1f6ac478F4638bF3D3` on chain_id = 1.
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 1)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 2)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 3,
        )

    let lp = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: lp, spender: fb, amount: 100 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: lp,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    // Fund EOA signer `0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266` with 2 WETH & allowance
    let signer = Address::new(0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: signer, spender: fb, amount: 2 * WAD },
        )

    let intent = SignedOrder {
        trader: signer,
        side: SELL_BASE,
        amount_in: 2 * WAD,
        limit_price: 2_500 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }

    // Verify on-chain EIP-712 digest matches offline secp256k1 digest
    let onchain_digest: u256 = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeIntentDigest { order: intent },
        )
    assert!(
        onchain_digest == 0x448b1f5e6e9e9a7db1e39df9d4a6ff51906eeeeb02b12213300612b3515b69c3,
    )

    let r: u256 = 0x3d91ca1cb1227ffff1c314806ed1193834496da813a9b80b4fb4246a9ac34dad
    let s: u256 = 0x65ddf4b5611599baed204d1eee244675b77972285801dc63de11a6a0eff6e3b6
    let v: u8 = 0x1c
    let sig = encode_packed((r, s, v)).as_bytes()

    // Separate relayer contract submits the gasless EIP-712 intent on behalf of `signer`!
    let relayer = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 55)
    let ord_id: u256 = evm
        .call(
            addr: relayer,
            gas: 1_500_000,
            value: Wei::zero(),
            message: TraderActorMsg::RelaySignedIntent {
                exchange: fb,
                order: intent,
                signature: sig,
            },
        )
    assert!(ord_id == 0)

    let next_nonce: u256 = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetNonce { trader: signer },
        )
    assert!(next_nonce == 1)

    let summary: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(summary.settled)

    let rec: OrderReceipt = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetOrderReceipt { batch_id: 1, order_id: 0 },
        )
    assert!(rec.trader == signer)
    assert!(rec.amount_filled == 2 * WAD)
    assert!(rec.payout_quote > 0)
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_eip712_erc1271_smart_wallet_intent() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 31)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 32)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 33,
        )

    let lp = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: lp, spender: fb, amount: 100 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: lp,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    let smart_wallet = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 34)
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: smart_wallet, amount: 6_000_000_000 },
        )
    let _: bool = evm
        .call(
            addr: smart_wallet,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken {
                token: usdc,
                spender: fb,
                amount: 6_000_000_000,
            },
        )

    let intent = SignedOrder {
        trader: smart_wallet,
        side: BUY_BASE,
        amount_in: 6_000_000_000,
        limit_price: 3_500 * WAD,
        batch_id: 1,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    let digest: u256 = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeIntentDigest { order: intent },
        )
    let _: bool = evm
        .call(
            addr: smart_wallet,
            gas: 300_000,
            value: Wei::zero(),
            message: TraderActorMsg::AuthorizeDigest { digest },
        )

    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent { order: intent, signature: Bytes::empty() },
        )
    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    let (claimed_weth, _): (u256, u256) = evm
        .call(
            addr: smart_wallet,
            gas: 1_000_000,
            value: Wei::zero(),
            message: TraderActorMsg::ClaimOnExchange { exchange: fb, batch_id: 1, order_id: 0 },
        )
    assert!(claimed_weth > WAD)
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_multicall_batch_claim_across_orders() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 41)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 42)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 43,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
