        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 283,
        )

    let wallet = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 284)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: wallet, amount: 2 * WAD },
        )
    let _: bool = evm
        .call(
            addr: wallet,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: 2 * WAD },
        )

    // Active batch is 1; signing for batch_id = 2 must revert!
    let wrong_batch = SignedOrder {
        trader: wallet,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 2_000 * WAD,
        batch_id: 2,
        nonce: 0,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    let d: u256 = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeIntentDigest { order: wrong_batch },
        )
    let _: bool = evm
        .call(
            addr: wallet,
            gas: 200_000,
            value: Wei::zero(),
            message: TraderActorMsg::AuthorizeDigest { digest: d },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent {
                order: wrong_batch,
                signature: Bytes::empty(),
            },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn evm_liquidity_first_deposit_min_liquidity_and_unused_side_refund()
uses (evm: mut Evm)
{
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 291)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 292)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 293,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 200 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 900_000_000_000,
            },
        )

    // 1. First deposit burns MINIMUM_LIQUIDITY (1,000) to Address::zero()
    let seed_shares: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )
    let burned: u256 = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLpShares { provider: Address::zero() },
        )
    assert!(burned == MINIMUM_LIQUIDITY)
    let res1: ReserveInfo = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetReserves {},
        )
    assert!(res1.total_shares == seed_shares + MINIMUM_LIQUIDITY)

    // 2. Subsequent imbalanced add: offer 10 fWETH + 60,000 fUSDC (2x too much fUSDC!).
    // Pool ratio is 3,000 fUSDC/fWETH, so only ~30,000 fUSDC should be pulled; the extra
    // ~30,000 fUSDC stays in the provider's wallet (unused side refunded / not pulled).
    let weth_before: u256 = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    let usdc_before: u256 = evm
        .call(
            addr: usdc,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    let added: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidity {
                amount_base: 10 * WAD,
                amount_quote: 60_000_000_000,
                min_shares: 1,
            },
        )
    let weth_after: u256 = evm
        .call(
            addr: weth,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    let usdc_after: u256 = evm
        .call(
            addr: usdc,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::BalanceOf { account: me },
        )
    let used_weth = weth_before - weth_after
    let used_usdc = usdc_before - usdc_after
    assert!(used_weth <= 10 * WAD && used_weth >= 10 * WAD - 10)
    assert!(used_usdc <= 30_000_000_001 && used_usdc >= 29_999_999_999)

    // 3. Immediate round-trip withdrawal rounds against user (in favor of pool):
    //    out_base <= used_weth && out_quote <= used_usdc
    let (out_base, out_quote): (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::RemoveLiquidity {
                shares: added,
                min_base: used_weth - 10,
                min_quote: used_usdc - 10,
            },
        )
    assert!(out_base <= used_weth)
    assert!(out_quote <= used_usdc)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_first_deposit_below_minimum_liquidity() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 301)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 302)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 18, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 303,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 10_000 },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 10_000 },
        )
    // sqrt(1_000 * 1_000) == 1_000 == MINIMUM_LIQUIDITY (not > MINIMUM_LIQUIDITY) -> must revert!
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidity {
                amount_base: 1_000,
                amount_quote: 1_000,
                min_shares: 0,
            },
        )
}

