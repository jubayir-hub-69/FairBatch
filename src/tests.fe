                amount_in: 6_000_000_000,
                limit_price: 3_500 * WAD,
            },
        )

    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )

    // Batch-claim BOTH orders in a single `MulticallMsg::Multicall` transaction!
    let c0_buf = encode_msg_calldata(FairBatchMsg::Claim { batch_id: 1, order_id: 0 })
    let c1_buf = encode_msg_calldata(FairBatchMsg::Claim { batch_id: 1, order_id: 1 })
    let calls = dyn_array_from(
        [Bytes::from_payload(source: c0_buf.span()), Bytes::from_payload(source: c1_buf.span())],
    )

    let results: DynArray<Bytes> = evm
        .call(
            addr: fb,
            gas: 2_000_000,
            value: Wei::zero(),
            message: MulticallMsg::Multicall { data: calls },
        )
    assert!(results.len() == 2)

    let r0: OrderReceipt = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetOrderReceipt { batch_id: 1, order_id: 0 },
        )
    let r1: OrderReceipt = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetOrderReceipt { batch_id: 1, order_id: 1 },
        )
    assert!(r0.claimed && r1.claimed)
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_multi_batch_rollover_and_lp_withdraw() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 51)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 52)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 53,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 300 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 900_000_000_000,
            },
        )

    let shares1: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )
    let shares2: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidity {
                amount_base: 50 * WAD,
                amount_quote: 150_000_000_000,
                min_shares: 0,
            },
        )
    let total_owned: u256 = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLpShares { provider: me },
        )
    assert!(total_owned == shares1 + shares2)

    // Batch #1 -> Settle -> automatically advances to Batch #2
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: 5 * WAD,
                limit_price: 2_500 * WAD,
            },
        )
    let s1: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(s1.batch_id == 1)

    let b2_info: BatchInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::CurrentBatch {},
        )
    assert!(b2_info.batch_id == 2 && b2_info.order_count == 0)

    // Batch #2 -> Settle -> advances to Batch #3
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: BUY_BASE,
                amount_in: 15_000_000_000,
                limit_price: 3_500 * WAD,
            },
        )
    let s2: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(s2.batch_id == 2)

    // Withdraw 50% of LP shares cleanly
    let res_before: ReserveInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetReserves {},
        )
    let (out_x, out_y): (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::RemoveLiquidity {
                shares: total_owned / 2,
                min_base: 0,
                min_quote: 0,
            },
        )
    assert!(out_x > 0 && out_y > 0)
    assert!(
        out_x <= res_before.reserve_base && out_y <= res_before.reserve_quote,
    )
}

#[test(balance = 100_000_000_000_000_000_000)]
fn evm_blacklisted_usdc_user_never_blocks_settlement() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 61)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 62)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 63,
        )

    let alice = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: alice, spender: fb, amount: 110 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: alice,
                spender: fb,
                amount: 300_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    let sanctioned = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 64)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: sanctioned, amount: 2 * WAD },
        )
    let _: bool = evm
        .call(
            addr: sanctioned,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: 2 * WAD },
        )

    // Both `alice` (order 0) and `sanctioned` (order 1) submit WETH sell orders
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_000 * WAD,
            },
        )
    let _: u256 = evm
        .call(
            addr: sanctioned,
            gas: 1_000_000,
            value: Wei::zero(),
            message: TraderActorMsg::SubmitDirect {
                exchange: fb,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_000 * WAD,
            },
        )

    // Circle USDC blacklists `sanctioned` BEFORE settlement!
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 200_000,
            value: Wei::zero(),
            message: MockErc20Msg::SetBlacklisted { account: sanctioned, blocked: true },
        )

    // Because FairBatch uses pull-over-push claims, `SettleBatch` succeeds 100% cleanly!
    let summary: BatchSummary = evm
        .call(
            addr: fb,
            gas: 5_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(summary.settled)

    // And Alice claims her USDC with zero interference from `sanctioned`!
    let (_, alice_usdc): (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::Claim { batch_id: 1, order_id: 0 },
        )
    assert!(alice_usdc > 5_000_000_000)
}

// ============================================================================
// Group E: Security Boundary & Attack Revert Tests (`#[test(should_revert)]`)
// ============================================================================

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_reentrancy_mutex_blocks_malicious_token_callback() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 71)
    let evil_quote = evm.create2<MaliciousReentrantERC20>(value: Wei::zero(), args: (), salt: 72)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, evil_quote, 18, 18, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 73,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 110 * WAD },
        )
    let _: bool = evm
        .call(
            addr: evil_quote,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 300_000 * WAD },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000 * WAD,
            },
        )

    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_000 * WAD,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 800_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: WAD,
                limit_price: 2_000 * WAD,
            },
        )
    let _: BatchSummary = evm
        .call(
            addr: fb,
            gas: 4_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )

    // Arm `evil_quote` to re-enter `Claim(1, 1)` inside `Claim(1, 0)`'s `safe_transfer`:
    let _: bool = evm
        .call(
            addr: evil_quote,
            gas: 300_000,
            value: Wei::zero(),
            message: ReentrantTokenAdminMsg::ArmAttack { target: fb, batch_id: 1, order_id: 1 },
        )

    // Reentrant callback hits EIP-1153 transient `Mutex` lock and reverts!
    let _: (u256, u256) = evm
        .call(
            addr: fb,
            gas: 2_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::Claim { batch_id: 1, order_id: 0 },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_payable_multicall_double_value_attack() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 81)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 82)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, seconds(60), seconds(60), ether(1)),
            salt: 83,
        )

    let c1 = encode_msg_calldata(FairBatchMsg::CommitOrder { commitment_hash: 0x1111 })
    let c2 = encode_msg_calldata(FairBatchMsg::CommitOrder { commitment_hash: 0x2222 })
    let calls = dyn_array_from(
        [Bytes::from_payload(source: c1.span()), Bytes::from_payload(source: c2.span())],
    )

    // Attempting to send 1 ETH once to satisfy two 1-ETH bonds via DELEGATECALL `Multicall` reverts!
    let _: DynArray<Bytes> = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: ether(1),
            message: MulticallMsg::Multicall { data: calls },
        )
}

