#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_direct_order_blocked_by_reserved_commit_slot()
uses (evm: mut Evm)
{
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 251)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 252)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 253,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 100 * WAD },
        )

    // 1 unrevealed commitment reserves 1 slot out of 64
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: Wei::zero(),
            message: FairBatchMsg::CommitOrder { commitment_hash: 0xCAFE01 },
        )

    var i: u256 = 0
    while i < MAX_ORDERS_PER_BATCH - 1 {
        let _: u256 = evm
            .call(
                addr: fb,
                gas: 500_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitDirectOrder {
                    side: SELL_BASE,
                    amount_in: WAD / 10,
                    limit_price: 2_000 * WAD,
                },
            )
        i = i + 1
    }

    // 64th direct order cannot steal the reserved reveal slot!
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 500_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitDirectOrder {
                side: SELL_BASE,
                amount_in: WAD / 10,
                limit_price: 2_000 * WAD,
            },
        )
}

#[test(balance = 10_000_000_000_000_000_000)]
fn evm_settle_full_64_order_batch() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 261)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 262)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 263,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 200 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 600_000_000_000,
            },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SeedReserves {
                amount_base: 100 * WAD,
                amount_quote: 300_000_000_000,
            },
        )

    // Submit 32 sell orders + 32 buy orders = full 64-order batch
    var i: u256 = 0
    while i < 32 {
        let _: u256 = evm
            .call(
                addr: fb,
                gas: 500_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitDirectOrder {
                    side: SELL_BASE,
                    amount_in: WAD / 2,
                    limit_price: (2_000 + i * 25) * WAD,
                },
            )
        let _: u256 = evm
            .call(
                addr: fb,
                gas: 500_000,
                value: Wei::zero(),
                message: FairBatchMsg::SubmitDirectOrder {
                    side: BUY_BASE,
                    amount_in: 1_500_000_000,
                    limit_price: (3_100 + i * 25) * WAD,
                },
            )
        i = i + 1
    }

    let summary: BatchSummary = evm
        .call(
            addr: fb,
            gas: 25_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SettleBatch {},
        )
    assert!(summary.settled)
    assert!(summary.order_count == MAX_ORDERS_PER_BATCH)
    assert!(summary.cow_matched_base > 0)
    assert!(summary.clearing_price > 0)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_eip712_skipped_nonce() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 271)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 272)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 273,
        )

    let wallet = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 274)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: wallet, amount: 2 * WAD },
        )
    let _: bool = evm
        .call(
            addr: wallet,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: 2 * WAD },
        )

    // Current nonce is 0; submitting nonce = 1 (skipped) must revert!
    let skipped = SignedOrder {
        trader: wallet,
        side: SELL_BASE,
        amount_in: WAD,
        limit_price: 2_000 * WAD,
        batch_id: 1,
        nonce: 1,
        deadline: Timestamp::from_seconds(1_000_000_000),
    }
    let d: u256 = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeIntentDigest { order: skipped },
        )
    let _: bool = evm
        .call(
            addr: wallet,
            gas: 200_000,
            value: Wei::zero(),
            message: TraderActorMsg::AuthorizeDigest { digest: d },
        )
    let _: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::SubmitSignedIntent { order: skipped, signature: Bytes::empty() },
        )
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_eip712_wrong_batch_id() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 281)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 282)
