#[test(balance = 10_000_000_000_000_000_000)]
fn evm_commit_reveal_bond_refund_to_stateful_receiver() uses (evm: mut Evm) {
    // Regression test: `revealOrder` must forward >2,300 gas when refunding the
    // commit bond so smart-contract wallets and EIP-7702 delegated accounts whose
    // `receive()` executes SSTORE succeed instead of reverting "Bond refund failed".
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 141)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 142)
    let bond_req = gwei(100_000) // 0.0001 ETH (same as Sepolia deployment)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), bond_req),
            salt: 143,
        )

    let smart_trader = evm.create2<TraderActor>(value: Wei::zero(), args: (), salt: 144)
    let _: bool = evm
        .call(
            addr: weth,
            gas: 300_000,
            value: Wei::zero(),
            message: MockErc20Msg::Mint { to: smart_trader, amount: 2 * WAD },
        )
    let _: bool = evm
        .call(
            addr: smart_trader,
            gas: 500_000,
            value: Wei::zero(),
            message: TraderActorMsg::ApproveToken { token: weth, spender: fb, amount: 2 * WAD },
        )

    let salt: u256 = 0x7702CAFE
    let commit_hash: u256 = evm
        .call(
            addr: fb,
            gas: 200_000,
            value: Wei::zero(),
            message: FairBatchMsg::ComputeCommitmentHash {
                batch_id: 1,
                trader: smart_trader,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_650 * WAD,
                salt,
            },
        )
    let commit_id: u256 = evm
        .call(
            addr: smart_trader,
            gas: 800_000,
            value: bond_req,
            message: TraderActorMsg::CommitOnExchange {
                exchange: fb,
                commitment_hash: commit_hash,
                bond_wei: bond_req,
            },
        )
    assert!(commit_id == 0)
    assert!(evm.balance(fb) == bond_req)
    assert!(evm.balance(smart_trader) == Wei::zero())

    let order_id: u256 = evm
        .call(
            addr: smart_trader,
            gas: 1_500_000,
            value: Wei::zero(),
            message: TraderActorMsg::RevealOnExchange {
                exchange: fb,
                commit_id,
                side: SELL_BASE,
                amount_in: 2 * WAD,
                limit_price: 2_650 * WAD,
                salt,
            },
        )
    assert!(order_id == 0)
    assert!(evm.balance(smart_trader) == bond_req)
    assert!(evm.balance(fb) == Wei::zero())

    // Proves `TraderActor`'s payable fallback executed its SSTORE (`refund_count += 1`),
    // which requires ~22,100 gas (impossible under the old `gas: 0` 2,300-gas stipend).
    let refunds: u256 = evm
        .call(
            addr: smart_trader,
            gas: 200_000,
            value: Wei::zero(),
            message: TraderActorMsg::RefundCount {},
        )
    assert!(refunds == 1)
}

#[test(balance = 10_000_000_000_000_000_000)]
fn evm_liquidity_lock_optional_and_partial_withdrawal() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 151)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 152)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 153,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 200 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 600_000_000_000,
            },
        )

    // 1. Add unlocked liquidity via `addLiquidity` (flexible default)
    let unlocked_shares: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidity {
                amount_base: 50 * WAD,
                amount_quote: 150_000_000_000,
                min_shares: 0,
            },
        )
    assert!(unlocked_shares > 0)

    // 2. Calling `addLiquidityLocked` with `Duration::zero()` stays unlocked (optional)
    let zero_lock_shares: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidityLocked {
                amount_base: 10 * WAD,
                amount_quote: 30_000_000_000,
                lock_duration: Duration::zero(),
                min_shares: 0,
            },
        )
    let lock_none: LiquidityLockInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLiquidityLock { provider: me },
        )
    assert!(lock_none.locked_shares == 0)
    assert!(
        lock_none.unlocked_shares == unlocked_shares + zero_lock_shares,
    )

    // 3. Add locked liquidity for 1 hour (3,600s)
    let now = evm.timestamp()
    let locked_first: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidityLocked {
                amount_base: 20 * WAD,
                amount_quote: 60_000_000_000,
                lock_duration: seconds(3_600),
                min_shares: 0,
            },
        )
    let lock_after: LiquidityLockInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLiquidityLock { provider: me },
        )
    assert!(lock_after.locked_shares == locked_first)
    assert!(lock_after.unlock_time == now + seconds(3_600))
    assert!(
        lock_after.unlocked_shares == unlocked_shares + zero_lock_shares,
    )

    // 4. Add another locked deposit with shorter duration -> shares accumulate, unlock_time is NOT shortened
    let locked_second: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::AddLiquidityLocked {
                amount_base: 20 * WAD,
                amount_quote: 60_000_000_000,
                lock_duration: seconds(600),
                min_shares: 0,
            },
        )
    let lock_combined: LiquidityLockInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLiquidityLock { provider: me },
        )
    assert!(
        lock_combined.locked_shares == locked_first + locked_second,
    )
    assert!(lock_combined.unlock_time == now + seconds(3_600))

    // 5. Unlocked portion can still be withdrawn immediately while locked shares stay protected
    let (out_base, out_quote): (u256, u256) = evm
        .call(
            addr: fb,
            gas: 1_000_000,
            value: Wei::zero(),
            message: FairBatchMsg::RemoveLiquidity {
                shares: unlocked_shares,
                min_base: 0,
                min_quote: 0,
            },
        )
    assert!(out_base > 0 && out_quote > 0)

    let lock_post_withdraw: LiquidityLockInfo = evm
        .call(
            addr: fb,
            gas: 300_000,
            value: Wei::zero(),
            message: FairBatchMsg::GetLiquidityLock { provider: me },
        )
    assert!(
        lock_post_withdraw.locked_shares == locked_first + locked_second,
    )
    assert!(lock_post_withdraw.unlocked_shares == zero_lock_shares)
}

#[test(should_revert, balance = 10_000_000_000_000_000_000)]
fn evm_revert_remove_locked_liquidity() uses (evm: mut Evm) {
    let weth = evm.create2<MockERC20>(value: Wei::zero(), args: (18,), salt: 161)
    let usdc = evm.create2<MockERC20>(value: Wei::zero(), args: (6,), salt: 162)
    let fb = evm
        .create2<FairBatch>(
            value: Wei::zero(),
            args: (weth, usdc, 18, 6, Duration::zero(), Duration::zero(), Wei::zero()),
            salt: 163,
        )

    let me = evm.address()
    let _: bool = evm
        .call(
            addr: weth,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove { owner: me, spender: fb, amount: 100 * WAD },
        )
    let _: bool = evm
        .call(
            addr: usdc,
            gas: 500_000,
            value: Wei::zero(),
            message: MockErc20Msg::MintAndApprove {
                owner: me,
                spender: fb,
                amount: 300_000_000_000,
            },
        )

    let locked: u256 = evm
        .call(
            addr: fb,
            gas: 1_000_000,
